#Tuple (fixed subjects)
subjects = ("Math", "Science", "English")

#List (marks)
marks = []

#Taking input
name = input("Enter student name:")

print("Enter marks for subjects:")
for sub in subjects:
    m = int(input(f"{sub}:"))
    marks.append(m)

#Dictionary (student record)
student = {
    "name" : name,
    "marks" : marks
}

#String operations
print("\n--String Operations--")
print("Uppercase Name:", name.upper())
print("Name length:", len(name))

#List operations
print("\n--List Operations--")
print("Marks:", marks)
print("Highest Marks:", max(marks))
print("Lowest Marks:", min(marks))

#Operators (calculation)
total = sum(marks)
average = total / len(marks)

print("\n--Operator usage--")
print("Total Marks:", total)
print("Average:", average)

#Condition using operator
if average >= 90:
    grade = "A+"
elif average >= 75:
    grade = "A"
elif average >=50:
    grade = "B"
else:
    grade = "Fail"

print("Grade:", grade)
