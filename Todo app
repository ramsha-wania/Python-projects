
import tkinter as tk
from tkinter import messagebox
import json
import os

FILE_NAME = "tasks.json"


def load_tasks():
    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                return json.load(file)
        except (json.JSONDecodeError, OSError):
            return []
    return []


def save_tasks():
    with open(FILE_NAME, "w") as file:
        json.dump(tasks, file, indent=4)


def refresh_tasks():
    task_list.delete(0, tk.END)

    for task in tasks:
        if task["completed"]:
            text = "✓ " + task["title"] + " (Completed)"
        else:
            text = "○ " + task["title"]

        task_list.insert(tk.END, text)

    completed = sum(task["completed"] for task in tasks)
    status.config(
        text=f"Total: {len(tasks)} | Completed: {completed}"
    )


def add_task():
    title = task_entry.get().strip()

    if title == "":
        messagebox.showwarning("Warning", "Enter a task first!")
        return

    tasks.append({
        "title": title,
        "completed": False
    })

    task_entry.delete(0, tk.END)
    save_tasks()
    refresh_tasks()


def complete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning("Warning", "Select a task first!")
        return

    index = selected[0]
    tasks[index]["completed"] = not tasks[index]["completed"]

    save_tasks()
    refresh_tasks()
    task_list.selection_set(index)


def delete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning("Warning", "Select a task first!")
        return

    index = selected[0]

    if messagebox.askyesno("Confirm", "Delete this task?"):
        tasks.pop(index)
        save_tasks()
        refresh_tasks()


# Main window
root = tk.Tk()
root.title("My To-Do List")
root.geometry("450x500")
root.configure(bg="#f0f4f8")

tasks = load_tasks()

title_label = tk.Label(
    root,
    text="My To-Do List",
    font=("Arial", 22, "bold"),
    bg="#f0f4f8",
    fg="#243247"
)
title_label.pack(pady=20)

task_entry = tk.Entry(root, font=("Arial", 12), width=25)
task_entry.pack(padx=20, pady=5, ipady=6)

add_button = tk.Button(
    root, text="Add Task",
    command=add_task,
    bg="#16a085", fg="white",
    font=("Arial", 11, "bold")
)
add_button.pack(pady=8)

task_list = tk.Listbox(
    root,
    font=("Arial", 12),
    width=40,
    height=12,
    selectbackground="#9ac7f5"
)
task_list.pack(padx=20, pady=10)

complete_button = tk.Button(
    root,
    text="Mark Complete / Undo",
    command=complete_task,
    bg="#2878c8", fg="white",
    font=("Arial", 10)
)
complete_button.pack(pady=4)

delete_button = tk.Button(
    root,
    text="Delete Selected",
    command=delete_task,
    bg="#dc6262", fg="white",
    font=("Arial", 10)
)
delete_button.pack(pady=4)

status = tk.Label(
    root, text="",
    font=("Arial", 10),
    bg="#f0f4f8"
)
status.pack(pady=8)

task_entry.bind("<Return>", lambda event: add_task())

refresh_tasks()
root.mainloop()
