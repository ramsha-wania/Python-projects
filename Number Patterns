#Continuous number triangle pattern
n = 5 
for i in range(1, n+1):
    print(" ".join(str(x) for x in range(1, i+1)))
print("____________________________")

#Inverted right angled number triangle pattern
n =5
for i in range(n, 0, -1):
    print(" ".join(str(x) for x in range(1, i+1)))
print("____________________________")

#Centered pyramid of number pattern
n = 5
for i in range(1, n+1):
    spaces = " " * (n-i)
    numbers = " ".join(str(x) for x in range(1, i+1))
    print(spaces + numbers)
print("____________________________")

#Palindromic triangle number pattern
n = 5
for i in range(1, n+1):
    spaces = " " * (n-i)
    left = "".join(str(x) for x in range(i, 0, -1))
    right = "".join(str(x) for x in range(2, i+1))
    print(spaces + left + right)
print("____________________________")

#Hollow square with number pattern
n = 5
for i in range(1, n+1):
    row = ""
    for j in range(1, n+1):
         row += (str(j) + " ") if (i==1 or i==n or j==1 or j==n) else "  "
    print(row)
print("____________________________")

#Number diamond pattern
n = 5
for i in range(1, n+1):
    spaces = " " * (n-i)
    numbers = " ".join(str(x) for x in range(1, i+1))
    print(spaces + numbers)
for i in range(n-1, 0, -1):
    spaces = " " * (n-i)
    numbers = " ".join(str(x) for x in range(1, i+1))
    print(spaces + numbers)
